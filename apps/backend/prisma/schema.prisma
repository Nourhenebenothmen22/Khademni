generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum KeywordType {
  REQUIRED
  OPTIONAL
  BONUS
}

enum RuleType {
  EXPERIENCE
  DEGREE
  CERTIFICATION
  KEYWORD
  CUSTOM
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum DocumentType {
  CV
  MOTIVATION_LETTER
}

enum DocumentStatus {
  UPLOADED
  SCANNED
  VALIDATED
  REJECTED
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ScoreRecommendation {
  HIGHLY_RECOMMENDED
  RECOMMENDED
  AVERAGE
  NOT_RECOMMENDED
}

enum EvaluationMetricType {
  ACCURACY
  PRECISION
  RECALL
  F1_SCORE
  PRECISION_AT_1
  PRECISION_AT_5
  NDCG_AT_5
  MAP
  MRR
}

model User {
  id                         String                     @id @default(cuid())
  fullName                   String
  email                      String                     @unique
  passwordHash               String
  role                       UserRole                   @default(CANDIDATE)
  isEmailVerified            Boolean                    @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  passwordChangedAt          DateTime?
  isActive                   Boolean                    @default(true)
  failedLoginAttempts        Int                        @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?
  mfaEnabled                 Boolean                    @default(false)
  mfaSecret                  String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  authSessions               AuthSession[]
  createdJobPosts            JobPost[]
  applications               Application[]
  applicationStatusChanges   ApplicationStatusHistory[] @relation("ChangedByUser")
  auditLogs                  AuditLog[]
  notifications              Notification[]

  @@index([role])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model JobPost {
  id            String            @id @default(cuid())
  title         String
  description   String
  requirements  String
  status        JobStatus         @default(DRAFT)
  deadline      DateTime?
  publishedAt   DateTime?
  closedAt      DateTime?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     User              @relation(fields: [createdById], references: [id])
  keywords      JobKeyword[]
  matchingRules JobMatchingRule[]
  applications  Application[]

  @@index([status])
  @@index([createdById])
  @@map("job_posts")
}

model JobKeyword {
  id        String      @id @default(cuid())
  jobPostId String
  keyword   String
  type      KeywordType
  weight    Float       @default(1.0)
  createdAt DateTime    @default(now())
  jobPost   JobPost     @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, keyword])
  @@index([jobPostId])
  @@index([jobPostId, type])
  @@map("job_keywords")
}

model JobMatchingRule {
  id        String   @id @default(cuid())
  jobPostId String
  ruleName  String
  type      RuleType
  condition Json
  weight    Float    @default(1.0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobPost   JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([jobPostId])
  @@map("job_matching_rules")
}

model Application {
  id               String                     @id @default(cuid())
  candidateId      String
  jobPostId        String
  motivationLetter String?
  status           ApplicationStatus          @default(SUBMITTED)
  trackingCode     String                     @unique
  submittedAt      DateTime                   @default(now())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  candidate        User                       @relation(fields: [candidateId], references: [id])
  jobPost          JobPost                    @relation(fields: [jobPostId], references: [id])
  documents        ApplicationDocument[]
  matchingRuns     MatchingRun[]
  score            ApplicationScore?
  statusHistory    ApplicationStatusHistory[]

  @@unique([candidateId, jobPostId])
  @@index([jobPostId])
  @@index([status])
  @@map("applications")
}

model ApplicationDocument {
  id            String               @id @default(cuid())
  applicationId String
  type          DocumentType
  status        DocumentStatus       @default(UPLOADED)
  originalName  String
  storedName    String
  storageKey    String
  mimeType      String
  extension     String
  sizeBytes     Int
  sha256        String
  uploadedAt    DateTime             @default(now())
  scannedAt     DateTime?
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parseResult   DocumentParseResult?

  @@unique([applicationId, type])
  @@index([sha256])
  @@map("application_documents")
}

model DocumentParseResult {
  id             String   @id @default(cuid())
  documentId     String   @unique
  extractedText  String
  structuredData Json?
  parserName     String
  parserVersion  String
  parsedAt       DateTime @default(now())

  document ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_parse_results")
}

model AIMatchingModel {
  id              String                      @id @default(cuid())
  name            String
  version         String
  algorithm       String
  description     String?
  isActive        Boolean                     @default(true)
  hyperparameters Json
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  matchingRuns    MatchingRun[]
  evaluations     AIMatchingModelEvaluation[]

  @@map("ai_matching_models")
}

model AIMatchingModelEvaluation {
  id                   String             @id @default(cuid())
  modelId              String
  datasetName          String
  evaluationSampleSize Int
  averageLatencyMs     Float?
  evaluationDetails    Json?
  evaluatedAt          DateTime?
  createdAt            DateTime           @default(now())
  model                AIMatchingModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  metrics              AIMatchingMetric[]

  @@index([modelId])
  @@map("ai_matching_model_evaluations")
}

model AIMatchingMetric {
  id           String                    @id @default(cuid())
  evaluationId String
  type         EvaluationMetricType
  value        Float
  createdAt    DateTime                  @default(now())
  evaluation   AIMatchingModelEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, type])
  @@index([evaluationId])
  @@index([type])
  @@map("ai_matching_metrics")
}

model MatchingRun {
  id               String            @id @default(cuid())
  applicationId    String
  modelId          String
  status           RunStatus         @default(PENDING)
  totalScore       Float?
  confidence       Float?
  matchedKeywords  Json?
  missingKeywords  Json?
  ruleResults      Json?
  scoreBreakdown   Json?
  semanticResult   Json?
  technicalMetrics Json?
  explanation      String?
  errorMessage     String?
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  model            AIMatchingModel   @relation(fields: [modelId], references: [id])
  applicationScore ApplicationScore?

  @@index([applicationId])
  @@index([applicationId, startedAt])
  @@index([modelId])
  @@index([status])
  @@map("matching_runs")
}

model ApplicationScore {
  id             String              @id @default(cuid())
  applicationId  String              @unique
  matchingRunId  String              @unique
  finalScore     Float
  recommendation ScoreRecommendation
  explanation    String?
  calculatedAt   DateTime            @default(now())
  application    Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  matchingRun    MatchingRun         @relation(fields: [matchingRunId], references: [id], onDelete: Cascade)

  @@index([finalScore])
  @@map("application_scores")
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   String
  reason        String?
  changedAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User               @relation("ChangedByUser", fields: [changedById], references: [id])

  @@index([applicationId])
  @@index([changedById])
  @@map("application_status_histories")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
