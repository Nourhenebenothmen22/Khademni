# ─── Khademni Platform Root Environment Configuration ───────────────────────
# Copy this file to .env before executing docker compose up

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=loopback
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# PostgreSQL Database Configuration
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=recruitment_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://recruitment_user:your_secure_postgres_password_here@postgres:5432/recruitment_db?schema=public

# Redis Configuration (Local Container or Cloud Provider)
REDIS_PORT=6379
# Option 1 (Docker / Local):
REDIS_URL=redis://recruitment_redis:6379
REDIS_PASSWORD=your_secure_redis_password_min_16_chars

# Option 2 (Managed Cloud Redis with TLS):
# REDIS_URL=rediss://default:your_password@your-redis-host.upstash.io:6379

# Security & Authentication (Min 32 characters each)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars_long
CSRF_SECRET=your_csrf_secret_token_key_minimum_32_chars_long

# AES-256-GCM Column Encryption (64 hex characters = 32 bytes)
DATABASE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Webhook Security (Min 16 characters)
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret_min_16_chars

# Application URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email@example.com
SMTP_PASS=your_brevo_smtp_key_here
SMTP_FROM=Khademni Recruitment <noreply@khademni.com>
