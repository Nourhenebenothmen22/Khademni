# ─── Core Environment Configuration ──────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=loopback
SLOW_QUERY_THRESHOLD_MS=300
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001

# ─── Database Configuration ──────────────────────────────────────
DATABASE_URL=postgresql://recruitment_user:your_secure_db_password_here@localhost:5432/recruitment_db?schema=public

# Docker Compose Postgres Service Variables
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=recruitment_db
POSTGRES_PORT=5432

# ─── Security & Authentication (Min 32 characters each) ──────────
JWT_ACCESS_SECRET=your_access_secret_here_must_be_at_least_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_must_be_at_least_32_chars
CSRF_SECRET=your_csrf_secret_here_must_be_at_least_32_chars

# ─── Application-Level Column Encryption (AES-256-GCM, 64 hex characters / 32 bytes) ──
DATABASE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Webhook Security (Min 16 characters) ─────────────────────────
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret_min_16_chars

# ─── Distributed Stores & Redis (Local or Managed Cloud) ─────────
# Option 1 (Local Redis):
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_secure_redis_password_min_16_chars

# Option 2 (Managed Cloud Redis e.g. Upstash, Redis Cloud with TLS):
# REDIS_URL=rediss://default:your_password@your-redis-host.upstash.io:6379

# ─── Database Seed Credentials (Optional for local seeding) ───────
SEED_ADMIN_EMAIL=admin@khademni.local
SEED_ADMIN_PASSWORD=your_seed_admin_password_min_12_chars
SEED_CANDIDATE_PASSWORD=your_seed_candidate_password_min_12_chars

# ─── Mail Transport / SMTP Configuration ────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@example.com
SMTP_PASS=your_brevo_smtp_key_here
SMTP_FROM=Khademni Recruitment <noreply@khademni.com>

# ─── File Storage & Uploads ─────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Application & Client URLs ──────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
