# ─── Core ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SLOW_QUERY_THRESHOLD_MS=300
CORS_ORIGIN=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://recruitment_user:recruitment_secure_pass_123@localhost:5432/recruitment_db?schema=public

# Docker Compose Postgres Variables
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=recruitment_secure_pass_123
POSTGRES_DB=recruitment_db
POSTGRES_PORT=5432

# ─── JWT Secrets (min 32 characters each) ───────────────────────
JWT_ACCESS_SECRET=your_access_secret_here_must_be_at_least_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_must_be_at_least_32_chars

# ─── SMTP / Email (optional — emails logged to console if unset)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Khademni <noreply@khademni.com>

# ─── File Storage ───────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Application URLs (used in email links) ────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
