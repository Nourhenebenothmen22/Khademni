# ─── Core Environment Configuration ──────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SLOW_QUERY_THRESHOLD_MS=300
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ─── Database Configuration ──────────────────────────────────────
DATABASE_URL=postgresql://recruitment_user:recruitment_secure_pass_123@localhost:5432/recruitment_db?schema=public

# Docker Compose Postgres Service Variables
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=recruitment_secure_pass_123
POSTGRES_DB=recruitment_db
POSTGRES_PORT=5432

# ─── Security & Authentication (Min 32 characters each) ──────────
JWT_ACCESS_SECRET=your_access_secret_here_must_be_at_least_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_must_be_at_least_32_chars
CSRF_SECRET=khademni_csrf_secret_token_key_32chars

# ─── Distributed Stores & Secrets Management (Optional) ─────────
# REDIS_URL=redis://localhost:6379
SECRETS_PROVIDER=env

# ─── Mail Transport / SMTP Configuration ────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@example.com
SMTP_PASS=your_brevo_smtp_key_here
SMTP_FROM=Khademni Recruitment <noreply@khademni.com>

# ─── File Storage & Uploads ─────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Application & Client URLs ──────────────────────────────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

