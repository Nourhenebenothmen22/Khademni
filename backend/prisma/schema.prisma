generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  ORGANIZATION_ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum KeywordType {
  REQUIRED
  OPTIONAL
  BONUS
}

enum RuleType {
  EXPERIENCE
  DEGREE
  CERTIFICATION
  KEYWORD
  CUSTOM
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum InterviewStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewType {
  SCREENING
  TECHNICAL
  PEDAGOGICAL_DEMO
  BEHAVIORAL
  FINAL_HR
}

enum MeetingProvider {
  ZOOM
  GOOGLE_MEET
  MS_TEAMS
  CUSTOM_LINK
  IN_PERSON
}

enum ScorecardRecommendation {
  STRONG_HIRE
  HIRE
  NEUTRAL
  NO_HIRE
  STRONG_NO_HIRE
}

enum DocumentType {
  CV
  MOTIVATION_LETTER
}

enum DocumentStatus {
  UPLOADED
  SCANNED
  VALIDATED
  REJECTED
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ScoreRecommendation {
  HIGHLY_RECOMMENDED
  RECOMMENDED
  AVERAGE
  NOT_RECOMMENDED
}

enum EvaluationMetricType {
  ACCURACY
  PRECISION
  RECALL
  F1_SCORE
  PRECISION_AT_1
  PRECISION_AT_5
  NDCG_AT_5
  MAP
  MRR
}

model Organization {
  id               String                       @id @default(cuid())
  name             String
  slug             String                       @unique
  domain           String?                      @unique
  logoKey          String?
  website          String?
  description      String?
  industry         String?
  location         String?
  address          String?
  phone            String?
  email            String?
  country          String?
  city             String?
  socialLinks      Json?
  isActive         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  users            User[]
  jobPosts         JobPost[]
  auditLogs        AuditLog[]
  interviews       Interview[]
  providerConfigs  OrganizationProviderConfig[]
  candidateHybridIndexes CandidateHybridIndex[]

  @@map("organizations")
}

model User {
  id                         String                     @id @default(cuid())
  organizationId             String?
  fullName                   String
  email                      String                     @unique
  passwordHash               String
  avatarKey                  String?
  role                       UserRole                   @default(CANDIDATE)
  isEmailVerified            Boolean                    @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  passwordChangedAt          DateTime?
  isActive                   Boolean                    @default(true)
  failedLoginAttempts        Int                        @default(0)
  lockedUntil                DateTime?
  lastLoginAt                DateTime?
  mfaEnabled                 Boolean                    @default(false)
  mfaSecret                  String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  organization               Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  authSessions               AuthSession[]
  createdJobPosts            JobPost[]
  applications               Application[]
  applicationStatusChanges   ApplicationStatusHistory[] @relation("ChangedByUser")
  auditLogs                  AuditLog[]
  notifications              Notification[]
  interviewsAsCandidate      Interview[]                @relation("CandidateInterviews")
  interviewsAsCreator        Interview[]                @relation("CreatedInterviews")
  interviewerAssignments     InterviewerAssignment[]
  submittedScorecards        InterviewScorecard[]

  @@index([role])
  @@index([organizationId])
  @@index([organizationId, role])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model JobPost {
  id             String            @id @default(cuid())
  organizationId String?
  title          String
  description    String
  requirements   String
  status         JobStatus         @default(DRAFT)
  deadline       DateTime?
  publishedAt    DateTime?
  closedAt       DateTime?
  createdById    String
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy      User              @relation(fields: [createdById], references: [id])
  keywords       JobKeyword[]
  matchingRules  JobMatchingRule[]
  applications   Application[]
  interviews     Interview[]
  candidateHybridIndexes CandidateHybridIndex[]

  @@index([status])
  @@index([createdById])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("job_posts")
}

model JobKeyword {
  id        String      @id @default(cuid())
  jobPostId String
  keyword   String
  type      KeywordType
  weight    Float       @default(1.0)
  createdAt DateTime    @default(now())
  jobPost   JobPost     @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([jobPostId, keyword])
  @@index([jobPostId])
  @@index([jobPostId, type])
  @@map("job_keywords")
}

model JobMatchingRule {
  id        String   @id @default(cuid())
  jobPostId String
  ruleName  String
  type      RuleType
  condition Json
  weight    Float    @default(1.0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobPost   JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([jobPostId])
  @@map("job_matching_rules")
}

model Application {
  id               String                     @id @default(cuid())
  candidateId      String
  jobPostId        String
  motivationLetter String?
  status           ApplicationStatus          @default(SUBMITTED)
  trackingCode     String                     @unique
  submittedAt      DateTime                   @default(now())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  candidate        User                       @relation(fields: [candidateId], references: [id])
  jobPost          JobPost                    @relation(fields: [jobPostId], references: [id])
  documents        ApplicationDocument[]
  matchingRuns     MatchingRun[]
  score            ApplicationScore?
  statusHistory    ApplicationStatusHistory[]
  interviews       Interview[]
  hybridIndex      CandidateHybridIndex?

  @@unique([candidateId, jobPostId])
  @@index([candidateId])
  @@index([jobPostId])
  @@index([status])
  @@map("applications")
}

model ApplicationDocument {
  id            String               @id @default(cuid())
  applicationId String
  type          DocumentType
  status        DocumentStatus       @default(UPLOADED)
  originalName  String
  storedName    String
  storageKey    String
  mimeType      String
  extension     String
  sizeBytes     Int
  sha256        String
  uploadedAt    DateTime             @default(now())
  scannedAt     DateTime?
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parseResult   DocumentParseResult?

  @@unique([applicationId, type])
  @@index([sha256])
  @@map("application_documents")
}

model DocumentParseResult {
  id             String                      @id @default(cuid())
  documentId     String                      @unique
  extractedText  String
  structuredData Json?
  embedding      Unsupported("vector(384)")?
  parserName     String
  parserVersion  String
  parsedAt       DateTime                    @default(now())

  document ApplicationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_parse_results")
}

model AIMatchingModel {
  id              String                      @id @default(cuid())
  name            String
  version         String
  algorithm       String
  description     String?
  isActive        Boolean                     @default(true)
  hyperparameters Json
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  matchingRuns    MatchingRun[]
  evaluations     AIMatchingModelEvaluation[]

  @@map("ai_matching_models")
}

model AIMatchingModelEvaluation {
  id                   String             @id @default(cuid())
  modelId              String
  datasetName          String
  evaluationSampleSize Int
  averageLatencyMs     Float?
  evaluationDetails    Json?
  evaluatedAt          DateTime?
  createdAt            DateTime           @default(now())
  model                AIMatchingModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  metrics              AIMatchingMetric[]

  @@index([modelId])
  @@map("ai_matching_model_evaluations")
}

model AIMatchingMetric {
  id           String                    @id @default(cuid())
  evaluationId String
  type         EvaluationMetricType
  value        Float
  createdAt    DateTime                  @default(now())
  evaluation   AIMatchingModelEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, type])
  @@index([evaluationId])
  @@index([type])
  @@map("ai_matching_metrics")
}

model MatchingRun {
  id               String            @id @default(cuid())
  applicationId    String
  modelId          String
  status           RunStatus         @default(PENDING)
  totalScore       Float?
  confidence       Float?
  matchedKeywords  Json?
  missingKeywords  Json?
  ruleResults      Json?
  scoreBreakdown   Json?
  semanticResult   Json?
  technicalMetrics Json?
  explanation      String?
  errorMessage     String?
  startedAt        DateTime          @default(now())
  finishedAt       DateTime?
  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  model            AIMatchingModel   @relation(fields: [modelId], references: [id])
  applicationScore ApplicationScore?

  @@index([applicationId])
  @@index([applicationId, startedAt])
  @@index([modelId])
  @@index([status])
  @@map("matching_runs")
}

model ApplicationScore {
  id             String              @id @default(cuid())
  applicationId  String              @unique
  matchingRunId  String              @unique
  finalScore     Float
  recommendation ScoreRecommendation
  explanation    String?
  calculatedAt   DateTime            @default(now())
  application    Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  matchingRun    MatchingRun         @relation(fields: [matchingRunId], references: [id], onDelete: Cascade)

  @@index([finalScore])
  @@map("application_scores")
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   String
  reason        String?
  changedAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User               @relation("ChangedByUser", fields: [changedById], references: [id])

  @@index([applicationId])
  @@index([changedById])
  @@map("application_status_histories")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Interview {
  id               String                  @id @default(cuid())
  organizationId   String
  applicationId    String
  jobPostId        String
  candidateId      String
  createdById      String
  title            String
  description      String?
  type             InterviewType           @default(TECHNICAL)
  status           InterviewStatus         @default(SCHEDULED)
  startTime        DateTime
  endTime          DateTime
  timezone         String                  @default("UTC")
  meetingProvider  MeetingProvider         @default(CUSTOM_LINK)
  meetingUrl       String?
  meetingId        String?
  meetingPasscode  String?
  locationDetails  String?
  cancelReason     String?
  rescheduleReason String?
  reminderSent     Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application      Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobPost          JobPost                 @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  candidate        User                    @relation("CandidateInterviews", fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy        User                    @relation("CreatedInterviews", fields: [createdById], references: [id])
  interviewers     InterviewerAssignment[]
  scorecards       InterviewScorecard[]

  @@index([organizationId])
  @@index([applicationId])
  @@index([candidateId])
  @@index([status])
  @@index([startTime])
  @@map("interviews")
}

model InterviewerAssignment {
  id             String    @id @default(cuid())
  interviewId    String
  userId         String
  isPrimary      Boolean   @default(false)
  responseStatus String    @default("PENDING")
  createdAt      DateTime  @default(now())

  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@index([userId])
  @@map("interviewer_assignments")
}

model InterviewScorecard {
  id             String                   @id @default(cuid())
  interviewId    String
  interviewerId  String
  recommendation ScorecardRecommendation
  overallNotes   String
  submittedAt    DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  interview      Interview                @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer    User                     @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  criteriaScores ScorecardCriteriaScore[]

  @@unique([interviewId, interviewerId])
  @@index([interviewerId])
  @@map("interview_scorecards")
}

model ScorecardCriteriaScore {
  id          String             @id @default(cuid())
  scorecardId String
  category    String
  criterion   String
  score       Int
  comment     String?
  createdAt   DateTime           @default(now())

  scorecard   InterviewScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@index([scorecardId])
  @@map("scorecard_criteria_scores")
}

model OrganizationProviderConfig {
  id             String          @id @default(cuid())
  organizationId String
  provider       MeetingProvider
  credentials    Json
  isEnabled      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("organization_provider_configs")
}

model CandidateHybridIndex {
  id             String       @id @default(cuid())
  applicationId  String       @unique @map("application_id")
  organizationId String       @map("organization_id")
  jobPostId      String       @map("job_post_id")
  content        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobPost        JobPost      @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([organizationId, jobPostId])
  @@map("candidate_hybrid_indexes")
}
